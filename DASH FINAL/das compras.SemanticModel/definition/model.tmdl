model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCategoria","DimCalendario","DimItem","FatoCompras","DimFornecedor"]

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

ref table DimCategoria
ref table DimCalendario
ref table DimItem
ref table FatoCompras
ref table DimFornecedor

ref cultureInfo pt-BR

