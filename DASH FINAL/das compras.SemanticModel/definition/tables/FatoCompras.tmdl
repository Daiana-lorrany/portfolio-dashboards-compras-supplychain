table FatoCompras
	lineageTag: 5dff7e4d-0961-4385-887e-48664f697f46

	measure 'Spend Total' = SUM(FatoCompras[Valor_Total])
		formatString: "R$" #,0.00
		lineageTag: c1222bbc-3839-4b72-8e97-aeea93018c87

	measure 'Savings Realizado' =
			
			SUMX(FatoCompras,(FatoCompras[Preco_Tabela] - FatoCompras[Preco_Negociado]) * FatoCompras[Quantidade])
		formatString: "R$" #,0.00
		lineageTag: ba28c537-0f75-4542-a8b7-4f5fdf4ab669

	measure '% Savings sobre Spend' = DIVIDE([Savings Realizado], SUMX(FatoCompras, FatoCompras[Preco_Tabela] * FatoCompras[Quantidade]),0)
		formatString: 0.0%
		lineageTag: 55025845-671e-4554-b1b6-13dd94d2e926

	measure '% Compras Emergenciais' =
			
			DIVIDE(CALCULATE([Spend Total], FatoCompras[Tipo_Compra] = "Emergencial"),[Spend Total],0)
		formatString: 0.0%
		lineageTag: 617cd252-4dee-4993-9f1d-78b60f9dc242

	measure '% OTIF' = ```
			DIVIDE(
			    CALCULATE(COUNTROWS(FatoCompras), 
			        FatoCompras[Data_Entrega_Real] <= FatoCompras[Data_Entrega_Prevista],
			        FatoCompras[Status_Pedido] = "Entregue"),
			    CALCULATE(COUNTROWS(FatoCompras), FatoCompras[Status_Pedido] = "Entregue"),0)
			```
		formatString: 0.0%
		lineageTag: 1dfa46f4-f07e-4804-92ba-ba4b3e40f028

	measure 'Spend Mes Anterior' = CALCULATE([Spend Total], DATEADD(DimCalendario[Data], -1, MONTH))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: ef073ff9-99f9-4051-9d24-621362f9b2be

	measure 'Variacao % MoM' = DIVIDE([Spend Total] - [Spend Mes Anterior], [Spend Mes Anterior],0)
		formatString: 0.0%
		lineageTag: a2590b6d-b5c2-4d22-a181-237b2f0679b0

	measure 'Savings Acumulado YTD' = TOTALYTD([Savings Realizado], DimCalendario[Data])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 031aadd6-052f-4327-8a8b-1c64f2a59a7e

	measure '% Spend Top 5 Fornecedores' =
			VAR TotalSpendContexto = CALCULATE([Spend Total], ALLSELECTED(DimFornecedor))
			VAR Top5 = TOPN(5, ALL(DimFornecedor), [Spend Total])
			RETURN DIVIDE(CALCULATE([Spend Total], Top5), TotalSpendContexto, 0)
		formatString: 0.0%
		lineageTag: 0a4ebf5b-a8a8-4444-8a07-81645bbef415

	measure 'Lead Time Medio (dias)' =
			
			AVERAGEX(
			    FILTER(FatoCompras, NOT(ISBLANK(FatoCompras[Data_Entrega_Real]))),
			    DATEDIFF(FatoCompras[Data_Pedido], FatoCompras[Data_Entrega_Real], DAY)
			)
		formatString: 0.0
		lineageTag: 7d42058a-7b31-403f-96c2-108fc39d8b60

	measure 'Ticket Medio por Pedido' = AVERAGEX(FatoCompras, FatoCompras[Valor_Total])
		formatString: \$#,0.00
		lineageTag: cac028b5-ad14-475b-83a0-feada77dcd3d

	measure 'Qtd Fornecedores Ativos' = DISTINCTCOUNT(FatoCompras[ID_Fornecedor])
		formatString: 0
		lineageTag: d7120299-f06e-46f2-a187-47f8fb5d3137

	measure 'Spend Itens Criticos' = CALCULATE([Spend Total], DimItem[Criticidade] = "Crítico")
		formatString: "R$" #,0.00
		lineageTag: 1ab53240-cdc4-4d38-b71e-3ac302216829

	measure 'Spend Total (Cartao)' = "R$ " & FORMAT(DIVIDE([Spend Total], 1000000), "#,0.0") & " Mi"
		lineageTag: 249a4776-934b-45cd-b364-8632d5efcfd4

	measure 'Savings Realizado (Cartao)' = "R$ " & FORMAT(DIVIDE([Savings Realizado], 1000000), "#,0.0") & " Mi"
		lineageTag: 755233be-7a1a-43bd-97ee-461986ad9957

	measure '% OTIF (Cartao)' = FORMAT([% OTIF], "0.0%")
		lineageTag: 4ce871d1-48d5-4952-ac32-277a35cfdc50

	column ID_Pedido
		dataType: string
		lineageTag: 24740c2b-07b1-434b-9660-d458bb8ed322
		summarizeBy: none
		sourceColumn: ID_Pedido

		annotation SummarizationSetBy = Automatic

