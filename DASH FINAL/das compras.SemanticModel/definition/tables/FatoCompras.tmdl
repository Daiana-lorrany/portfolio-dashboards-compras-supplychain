				    FatoCompras_Sheet = Fonte{[Item="FatoCompras",Kind="Sheet"]}[Data],
				    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(FatoCompras_Sheet, [PromoteAllScalars=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"ID_Pedido", type text}, {"Data_Pedido", Int64.Type}, {"Data_Entrega_Prevista", Int64.Type}, {"Data_Entrega_Real", Int64.Type}, {"ID_Fornecedor", type text}, {"ID_Item", type text}, {"ID_Categoria", type text}, {"Quantidade", Int64.Type}, {"Preco_Tabela", type number}, {"Preco_Negociado", type number}, {"Valor_Total", type number}, {"Tipo_Compra", type text}, {"Status_Pedido", type text}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

